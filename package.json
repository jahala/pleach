{
  "name": "pleach",
  "version": "1.0.0",
  "private": true,
  "description": "Deterministic conductor for DAGs of verified agent work — isolates each plan node in a git worktree, enforces gates, and publishes a node/<id> branch only for verified work.",
  "license": "MIT",
  "author": "Jan Hallvard Larsen <jan@m-a-d.co>",
  "homepage": "https://jahala.github.io/pleach/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jahala/pleach.git"
  },
  "bugs": {
    "url": "https://github.com/jahala/pleach/issues"
  },
  "keywords": [
    "agents",
    "ai-agents",
    "conductor",
    "dag",
    "verification",
    "git",
    "bun",
    "typescript",
    "llm"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./adapters/umbel": "./src/adapters/umbel.ts",
    "./adapters/tend": "./src/adapters/tend.ts",
    "./adapters/git": "./src/adapters/git.ts",
    "./adapters/scripted": "./src/adapters/scripted.ts",
    "./adapters/direct-cli": "./src/adapters/direct-cli.ts",
    "./config": "./src/faces/config.ts"
  },
  "bin": {
    "pleach": "./src/main.ts"
  },
  "files": [
    "src",
    "docs/contract",
    "docs/adapters.md",
    "docs/journal.md",
    ".claude/skills/pleach-plan"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src test",
    "check": "bun run typecheck && bun run lint && bun run test"
  },
  "dependencies": {
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@types/node": "^25.9.3",
    "bun-types": "^1.3.14",
    "typescript": "^6.0.3"
  }
}
